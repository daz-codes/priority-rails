<%= turbo_frame_tag dom_id(category) do %>
  <div class="flex items-center gap-2 px-3 py-2 rounded-lg bg-surface-secondary">
    <span class="size-4 rounded-full shrink-0 border border-border-primary" style="background-color: <%= category.color %>"></span>
    <%= form_with model: [list, category], class: "flex items-center gap-2 flex-1 min-w-0" do |f| %>
      <%= f.text_field :name, value: category.name, class: "flex-1 min-w-0 px-2 py-1 border border-transparent rounded text-sm bg-transparent hover:border-border-input focus:border-sky-400 focus:outline-none transition-all", data: { he_blur: "$el.form.requestSubmit()" } %>

      <div class="flex items-center gap-0.5 shrink-0">
        <% CategoriesController::COLORS.each do |color| %>
          <label class="cursor-pointer">
            <%= f.radio_button :color, color, class: "hidden", data: { he_change: "$el.form.requestSubmit()" } %>
            <span class="block size-5 rounded-full border-2 transition-all duration-100 hover:scale-110 <%= color == category.color ? 'border-text-secondary scale-110' : 'border-transparent' %>" style="background-color: <%= color %>"></span>
          </label>
        <% end %>
      </div>
    <% end %>

    <% if list.default_category_id == category.id %>
      <span class="shrink-0 text-amber-400 p-1" title="Default for new tasks"><i class="fa-solid fa-star text-xs"></i></span>
    <% else %>
      <%= button_to make_default_list_category_path(list, category), method: :patch, title: "Make default for new tasks",
            form: { data: { turbo_frame: "_top" } },
            class: "shrink-0 text-text-muted hover:text-amber-400 transition-all duration-100 cursor-pointer bg-transparent border-none p-1" do %>
        <i class="fa-regular fa-star text-xs"></i>
      <% end %>
    <% end %>
    <%= button_to list_category_path(list, category), method: :delete, class: "shrink-0 text-text-muted hover:text-red-400 transition-all duration-100 cursor-pointer bg-transparent border-none p-1", data: { turbo_confirm: "Remove this category?" } do %>
      <i class="fa-solid fa-xmark text-xs"></i>
    <% end %>
  </div>
<% end %>
