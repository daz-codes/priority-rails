<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Priority" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# No time zone on the account yet: lib/time_zone.js sends the browser's %>
    <% if authenticated? && Current.user.time_zone.blank? %>
      <meta name="detect-time-zone" content="<%= time_zone_account_path %>">
    <% end %>

    <script>
      (function() {
        var s = localStorage.getItem("theme");
        var d = s ? s === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (d) document.documentElement.classList.add("dark");
      })();
    </script>

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%# Icons live in public/. Bump ICON_VERSION when they change so browsers and devices refetch them %>
    <% icon_version = ApplicationHelper::ICON_VERSION %>
    <link rel="icon" href="/favicon.svg?v=<%= icon_version %>" type="image/svg+xml">
    <link rel="icon" href="/favicon-96x96.png?v=<%= icon_version %>" type="image/png" sizes="96x96">
    <link rel="icon" href="/favicon.ico?v=<%= icon_version %>" sizes="48x48">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=<%= icon_version %>" sizes="180x180">
    <meta name="apple-mobile-web-app-title" content="Priority">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400..900&family=Nunito&family=Jost&family=Bebas+Neue&family=Pacifico&family=Anton&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "lexxy" %>
    <script src="https://kit.fontawesome.com/6b5e91c70a.js" crossorigin="anonymous"></script>
    <%= javascript_importmap_tags %>
  </head>

  <body class="font-body text-text-primary bg-surface-primary max-w-[100vw] overflow-x-hidden" data-he-import="behaviors/keyboard,behaviors/swipe">
    <% if authenticated? && !content_for?(:focus_mode) %>
      <%# Extra room on phones, where the browser blurs the top edge of the page under its status bar %>
      <header class="px-4 pt-7 sm:pt-3 flex justify-center">
        <%= render "lists/menu" %>
      </header>
    <% end %>

    <% if authenticated? %>
      <div id="toasts" class="fixed inset-x-4 flex justify-center z-50 pointer-events-none" style="bottom: calc(1.5rem + env(safe-area-inset-bottom))"></div>
    <% end %>

    <main class="max-w-2xl mx-auto w-full px-4 pt-2 overflow-x-clip">
      <%= tag.div(flash[:alert], id: "flash_alert", role: "alert", class: "text-sm text-red-600 bg-red-50 dark:bg-red-950 dark:text-red-300 rounded-lg px-4 py-2.5 my-2 text-center") if flash[:alert].present? %>
      <%= yield %>
    </main>

  </body>
</html>
