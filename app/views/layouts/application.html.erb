<!DOCTYPE html>
<html data-controller="theme">
  <head>
    <title><%= content_for(:title) || "Priority" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script>
      (function() {
        var s = localStorage.getItem("theme");
        var d = s ? s === "dark" : window.matchMedia("(prefers-color-scheme: dark)").matches;
        if (d) document.documentElement.classList.add("dark");
      })();
    </script>

    <%= yield :head %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon-192.png">
    <link href="https://fonts.googleapis.com/css2?family=Nunito&family=Jost&family=Bebas+Neue&family=Pacifico&family=Anton&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "lexxy" %>
    <script src="https://kit.fontawesome.com/6b5e91c70a.js" crossorigin="anonymous"></script>
    <%= javascript_importmap_tags %>
  </head>

  <body class="font-body text-text-primary bg-surface-primary max-w-[100vw] overflow-x-hidden" data-controller="keyboard">
    <% if authenticated? %>
      <header class="px-4 pt-3 flex justify-center">
        <%= render "lists/menu" %>
      </header>
    <% end %>

    <% if authenticated? %>
      <div id="toasts" class="fixed bottom-6 inset-x-0 flex justify-center px-4 z-50 pointer-events-none"></div>
    <% end %>

    <main class="max-w-2xl mx-auto w-full px-4 pt-2 overflow-hidden">
      <%= tag.div(flash[:alert], id: "flash_alert", role: "alert", class: "text-sm text-red-600 bg-red-50 dark:bg-red-950 dark:text-red-300 rounded-lg px-4 py-2.5 my-2 text-center") if flash[:alert].present? %>
      <%= yield %>
    </main>

  </body>
</html>
