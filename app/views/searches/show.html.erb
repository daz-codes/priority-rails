<% content_for :title, @query.present? ? "Search: #{@query}" : "Search" %>

<div class="max-w-lg mx-auto space-y-4 py-4">
  <h1 class="text-3xl font-heading text-center m-0 pb-2">Search</h1>
  <%= form_with url: search_path, method: :get, class: "flex gap-2" do |form| %>
    <%= form.search_field :q, value: @query, autofocus: true, minlength: 2, placeholder: "Search tasks, notes and lists...",
          class: field_classes %>
    <%= form.submit "Search", name: nil, class: primary_button_classes %>
  <% end %>

  <% if @tasks %>
    <% if @lists.any? %>
      <section class="<%= panel_classes %>">
        <h2 class="<%= panel_heading_classes %>">Lists</h2>
        <ul class="list-none p-0 m-0 space-y-1">
          <% @lists.each do |list| %>
            <li><%= link_to list.name, list, class: "block px-3 py-2 rounded-(--card-radius) bg-surface-primary hover:bg-surface-hover no-underline text-base font-bold text-text-primary" %></li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <section class="<%= panel_classes %>">
      <h2 class="<%= panel_heading_classes %>">Tasks</h2>
      <% if @tasks.any? %>
        <ul class="list-none p-0 m-0 space-y-1">
          <% @tasks.each do |task| %>
            <% tab = ("completed" if task.completed?) || ("snoozed" if task.snoozed?) %>
            <li id="<%= dom_id(task, :result) %>">
              <%= link_to list_path(task.list, list: tab, anchor: dom_id(task)), class: "flex items-center gap-3 px-3 py-2 rounded-(--card-radius) bg-surface-primary hover:bg-surface-hover no-underline" do %>
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-base font-bold text-text-primary <%= 'line-through opacity-60' if task.completed? %>"><%= task.description %></span>
                  <span class="block text-[11px] font-black uppercase tracking-wider text-text-tertiary truncate">
                    <%= task.list.name %><%= " · Completed" if task.completed? %><%= " · Snoozed" if task.snoozed? %>
                  </span>
                </span>
                <% if task.category %>
                  <span class="<%= badge_classes %> shrink-0" style="background-color: <%= task.category.color %>; color: <%= darken_color(task.category.color) %>"><%= task.category.name %></span>
                <% end %>
              <% end %>
            </li>
          <% end %>
        </ul>
        <% if @tasks.size == SearchesController::RESULT_LIMIT %>
          <p class="text-xs font-semibold text-text-tertiary mt-3 mb-0">Showing the first <%= SearchesController::RESULT_LIMIT %> matches. Try a more specific search.</p>
        <% end %>
      <% else %>
        <p class="text-base font-bold text-text-tertiary m-0">No tasks match "<%= @query %>".</p>
      <% end %>
    </section>
  <% elsif @query.present? %>
    <p class="text-base font-bold text-text-tertiary text-center">Type at least 2 characters to search.</p>
  <% end %>
</div>
