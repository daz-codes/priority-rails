<div class="max-w-md mx-auto py-8">
  <div class="text-center mb-8">
    <%= logo :large %>
    <p class="text-lg font-bold text-text-secondary mt-2 mb-6">Focus on what matters.</p>
  </div>

  <div class="bg-surface-secondary rounded-2xl p-6 mb-6">
    <div class="space-y-3 text-base font-bold text-text-secondary mb-6">
      <div class="flex items-start gap-3">
        <span class="size-5 shrink-0 rounded-full border-2 border-brand-blue text-brand-blue flex items-center justify-center text-xs font-bold mt-0.5">!</span>
        <span>Drag and drop to organise tasks by what matters most</span>
      </div>
      <div class="flex items-start gap-3">
        <span class="size-5 shrink-0 rounded-full border-2 border-brand-green text-brand-green flex items-center justify-center text-xs font-bold mt-0.5">!</span>
        <span>Snooze tasks until you're ready to deal with them</span>
      </div>
      <div class="flex items-start gap-3">
        <span class="size-5 shrink-0 rounded-full border-2 border-brand-red text-brand-red flex items-center justify-center text-xs font-bold mt-0.5">!</span>
        <span>Focus mode shows only your top 3 priorities</span>
      </div>
      <div class="flex items-start gap-3">
        <span class="size-5 shrink-0 rounded-full border-2 border-brand-blue text-brand-blue flex items-center justify-center text-xs font-bold mt-0.5">!</span>
        <span>Categorise, collaborate and share lists with others</span>
      </div>
    </div>

    <hr class="border-border-input mb-5">

    <%= form_with url: session_path, class: "space-y-3" do |form| %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", placeholder: "Email address", value: params[:email_address], class: field_classes %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "Password", maxlength: 72, class: field_classes %>
      <%= form.submit "Sign In", class: "#{primary_button_classes} w-full !py-3" %>
    <% end %>
  </div>

  <div class="text-center text-sm font-semibold text-text-tertiary space-y-2">
    <p class="m-0">Don't have an account? <%= link_to "Sign up", new_registration_path, class: "text-brand-blue font-black uppercase tracking-wider text-xs no-underline hover:brightness-110" %></p>
    <p class="m-0"><%= link_to "Forgot password?", new_password_path, class: "text-text-tertiary no-underline hover:text-text-secondary" %></p>
  </div>
</div>
