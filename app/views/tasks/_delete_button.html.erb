<% labelled = local_assigns[:labelled] %>
<%= button_to task_path(task),
    title: "Delete task",
    method: :delete,
    data: { turbo_frame: "_top" },
    class: labelled ? "#{task_panel_button_classes} hover:!text-red-500 hover:!border-red-300" : "bg-transparent border-0 text-text-muted cursor-pointer p-0.5 text-sm hover:text-red-400 transition-all duration-100" do %>
  <%= task_action_content "fa-trash", "Delete", labelled: labelled %>
<% end %>
