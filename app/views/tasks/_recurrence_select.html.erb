<%# Opens the page's shared recurrence modal (tasks/_modals) with this task's current rule %>
<% labelled = local_assigns[:labelled] %>
<% details = { url: task_path(task), type: task.recurrence_type, day: task.recurrence_day, month: task.recurrence_month, label: task.recurrence_label } %>
<button type="button" title="Recurrence" class="<%= labelled ? task_panel_button_classes : task_button_classes %> <%= 'text-cyan-400' if task.recurring? %>"
        data-he-click="[recurPanel = 'main', recurTask = <%= details.to_json %>]">
  <%= task_action_content "fa-arrows-rotate", (task.recurring? ? task.recurrence_label : "Recur"), labelled: labelled %>
</button>
