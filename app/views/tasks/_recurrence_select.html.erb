<%# Expression that closes the modal and saves a recurrence rule; `month` may be the JS variable chosen in the yearly panel %>
<% save = ->(type, day: "null", month: "null") {
     "[open = false, $patch('#{task_path(task)}', { task: { recurrence_type: #{type ? "'#{type}'" : 'null'}, recurrence_day: #{day}, recurrence_month: #{month} } })]"
   } %>
<% option_classes = "px-3 py-2.5 cursor-pointer rounded-lg hover:bg-surface-hover text-text-secondary text-sm" %>
<% back_classes = "px-3 py-2 text-xs text-text-tertiary uppercase tracking-wide flex items-center gap-2" %>

<div data-he-data="{ open: false, panel: 'main', month: null }" class="relative inline-block">
  <% labelled = local_assigns[:labelled] %>
  <button type="button" title="Recurrence" class="<%= labelled ? task_panel_button_classes : task_button_classes %> <%= 'text-cyan-400' if task.recurring? %>"
          data-he-click="[panel = 'main', open = !open]">
    <%= task_action_content "fa-arrows-rotate", (task.recurring? ? task.recurrence_label : "Recur"), labelled: labelled %>
  </button>

  <%# Backdrop %>
  <div class="fixed inset-0 bg-black/50 z-40" hidden data-he-hidden="!open" data-he-click="open = false"></div>

  <%# Modal %>
  <div class="<%= modal_classes %>" hidden data-he-hidden="!open" data-recurrence-modal>

    <%# Header %>
    <div class="flex items-center justify-between px-4 py-3 border-b border-border-secondary">
      <h3 class="text-sm font-semibold text-text-primary m-0">Recurring Task</h3>
      <button type="button" title="Close" class="text-text-tertiary hover:text-text-primary cursor-pointer" data-he-click="open = false">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <%# Current status %>
    <div class="px-4 py-3 border-b border-border-secondary bg-surface-secondary/50">
      <div class="text-xs text-text-tertiary uppercase tracking-wide mb-1">Current</div>
      <div class="text-sm text-text-primary font-medium">
        <% if task.recurring? %>
          <i class="fa-solid fa-arrows-rotate text-cyan-400 text-xs mr-1"></i> <%= task.recurrence_label %>
        <% else %>
          <i class="fa-solid fa-minus text-text-tertiary text-xs mr-1"></i> Not recurring
        <% end %>
      </div>
    </div>

    <%# Main panel %>
    <div class="p-2" data-he-hidden="panel != 'main'">
      <div class="<%= option_classes %> flex items-center gap-2 <%= 'text-cyan-400 font-medium' unless task.recurring? %>" data-he-click="<%= save.(nil) %>">
        <i class="fa-solid fa-minus w-4 text-center text-xs"></i> None
      </div>
      <div class="<%= option_classes %> flex items-center gap-2 <%= 'text-cyan-400 font-medium' if task.recurrence_type == 'daily' %>" data-he-click="<%= save.("daily") %>">
        <i class="fa-solid fa-sun w-4 text-center text-xs"></i> Daily
      </div>
      <div class="<%= option_classes %> flex items-center gap-2 <%= 'text-cyan-400 font-medium' if task.recurrence_type == 'weekly' %>" data-he-click="panel = 'weekly'">
        <i class="fa-solid fa-calendar-week w-4 text-center text-xs"></i> Weekly <span class="ml-auto text-text-tertiary text-xs">&rsaquo;</span>
      </div>
      <div class="<%= option_classes %> flex items-center gap-2 <%= 'text-cyan-400 font-medium' if task.recurrence_type == 'monthly' %>" data-he-click="panel = 'monthly'">
        <i class="fa-solid fa-calendar-days w-4 text-center text-xs"></i> Monthly <span class="ml-auto text-text-tertiary text-xs">&rsaquo;</span>
      </div>
      <div class="<%= option_classes %> flex items-center gap-2 <%= 'text-cyan-400 font-medium' if task.recurrence_type == 'yearly' %>" data-he-click="panel = 'yearly'">
        <i class="fa-solid fa-calendar w-4 text-center text-xs"></i> Yearly <span class="ml-auto text-text-tertiary text-xs">&rsaquo;</span>
      </div>
    </div>

    <%# Weekly panel - pick day of week %>
    <div class="p-2" hidden data-he-hidden="panel != 'weekly'">
      <div class="<%= back_classes %>">
        <button type="button" title="Back" class="hover:text-text-primary cursor-pointer" data-he-click="panel = 'main'"><i class="fa-solid fa-arrow-left"></i></button>
        Pick a day
      </div>
      <% Date::DAYNAMES.each_with_index do |day, i| %>
        <div class="<%= option_classes %> <%= 'text-cyan-400 font-medium' if task.recurrence_type == 'weekly' && task.recurrence_day == i %>" data-he-click="<%= save.("weekly", day: i) %>"><%= day %></div>
      <% end %>
    </div>

    <%# Monthly panel - pick day of month %>
    <div class="p-2" hidden data-he-hidden="panel != 'monthly'">
      <div class="<%= back_classes %>">
        <button type="button" title="Back" class="hover:text-text-primary cursor-pointer" data-he-click="panel = 'main'"><i class="fa-solid fa-arrow-left"></i></button>
        Pick a day of the month
      </div>
      <div class="grid grid-cols-7 gap-1 p-2">
        <% (1..31).each do |d| %>
          <div class="w-8 h-8 flex items-center justify-center cursor-pointer rounded-lg hover:bg-surface-hover text-text-secondary text-sm <%= 'bg-cyan-400/20 text-cyan-400 font-medium' if task.recurrence_type == 'monthly' && task.recurrence_day == d %>" data-he-click="<%= save.("monthly", day: d) %>"><%= d %></div>
        <% end %>
      </div>
    </div>

    <%# Yearly panel - pick month %>
    <div class="p-2" hidden data-he-hidden="panel != 'yearly'">
      <div class="<%= back_classes %>">
        <button type="button" title="Back" class="hover:text-text-primary cursor-pointer" data-he-click="panel = 'main'"><i class="fa-solid fa-arrow-left"></i></button>
        Pick a month
      </div>
      <div class="grid grid-cols-3 gap-1 p-2">
        <% Date::MONTHNAMES.compact.each.with_index(1) do |month, number| %>
          <div class="px-2 py-2.5 cursor-pointer rounded-lg hover:bg-surface-hover text-text-secondary text-sm text-center <%= 'bg-cyan-400/20 text-cyan-400 font-medium' if task.recurrence_type == 'yearly' && task.recurrence_month == number %>" data-he-click="[month = <%= number %>, panel = 'yearlyDay']"><%= month %></div>
        <% end %>
      </div>
    </div>

    <%# Yearly day panel - pick day after month selected %>
    <div class="p-2" hidden data-he-hidden="panel != 'yearlyDay'">
      <div class="<%= back_classes %>">
        <button type="button" title="Back" class="hover:text-text-primary cursor-pointer" data-he-click="panel = 'yearly'"><i class="fa-solid fa-arrow-left"></i></button>
        Pick a day
      </div>
      <div class="grid grid-cols-7 gap-1 p-2">
        <% (1..31).each do |d| %>
          <div class="w-8 h-8 flex items-center justify-center cursor-pointer rounded-lg hover:bg-surface-hover text-text-secondary text-sm" data-he-click="<%= save.("yearly", day: d, month: "month") %>"><%= d %></div>
        <% end %>
      </div>
    </div>
  </div>
</div>
