<%= turbo_frame_tag "task_frame_#{@task.id}" do %>
  <% form_id = "task_panel_form_#{@task.id}" %>
  <div class="py-2 space-y-3" data-task-panel>
    <%# Complete + name (the name belongs to the form below via the form attribute, as the
        action buttons in between are forms of their own and forms can't be nested) %>
    <div class="flex items-center gap-2">
      <span class="shrink-0" data-controller="task" data-task-url-value="<%= task_path(@task) %>">
        <%= check_box_tag "task_panel_checkbox_#{@task.id}", "1", @task.completed?, class: "task-checkbox", data: { action: "task#toggle" }, aria: { label: "Complete task" } %>
      </span>
      <%= text_field_tag "task[description]", @task.description, form: form_id, id: "task_panel_description_#{@task.id}", required: true, aria: { label: "Task" },
            class: "flex-1 min-w-0 p-2 border border-border-input rounded-xl outline-none text-base focus:border-sky-400 focus:ring-1 focus:ring-sky-400 bg-input-bg" %>
      <%# Enter submits via the form's first submit button; without this that would be a note toolbar button %>
      <button type="submit" form="<%= form_id %>" class="sr-only" tabindex="-1" aria-hidden="true"></button>
    </div>
    <% if @task.errors.any? %>
      <div class="text-sm text-red-600 bg-red-50 dark:bg-red-950 dark:text-red-300 rounded-lg px-4 py-2.5"><%= @task.errors.full_messages.to_sentence %></div>
    <% end %>

    <%# Actions: these happen straight away %>
    <div class="flex flex-wrap items-center gap-2">
      <% unless @task.completed? %>
        <%= render @task.snoozed? ? "tasks/unsnooze_button" : "tasks/snooze_select", task: @task, labelled: true %>
        <%= render "tasks/recurrence_select", task: @task, labelled: true %>
      <% end %>
      <%= render "tasks/delete_button", task: @task, labelled: true %>
    </div>

    <%# Everything below is saved together %>
    <%= form_with model: @task, id: form_id, data: { turbo_frame: "_top" }, class: "space-y-3" do |form| %>
      <% lists = Current.user.lists.order(:name) %>
      <% if lists.size > 1 %>
        <div class="flex items-center gap-2">
          <%= form.label :list_id, "List", for: "task_panel_list_#{@task.id}", class: "text-sm text-text-tertiary shrink-0" %>
          <%= form.select :list_id, lists.map { |l| [ l.name, l.id ] }, {}, id: "task_panel_list_#{@task.id}",
                class: "flex-1 min-w-0 px-3 py-2 border border-border-input rounded-lg text-sm bg-input-bg" %>
        </div>
      <% end %>

      <%= form.rich_textarea :note, id: "task_panel_note_#{@task.id}", class: "w-full", placeholder: "Add a note..." %>

      <div class="flex items-center gap-2">
        <%= form.button type: "submit", class: "px-4 py-2 rounded-full bg-sky-400 text-white text-sm font-semibold hover:bg-sky-500 transition-all duration-100 cursor-pointer border-0" do %>
          <i class="fa-solid fa-check text-xs"></i> Save
        <% end %>
        <%= link_to request.referer || @task.list, class: "px-4 py-2 rounded-full border border-border-input text-sm font-semibold text-text-secondary hover:bg-surface-hover transition-all duration-100 no-underline", data: { turbo_frame: "_top" } do %>
          <i class="fa-solid fa-xmark text-xs"></i> Cancel
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
