<% labelled = local_assigns[:labelled] %>
<%= button_to task_path(task),
    method: :patch,
    params: { task: { snoozed_until: nil } },
    title: "Unsnooze task",
    class: labelled ? task_panel_button_classes : task_button_classes do %>
  <%= task_action_content "fa-clock-rotate-left", "Unsnooze", labelled: labelled %>
<% end %>
