<div data-he-data="{ open: false }" class="relative inline-block">
  <% labelled = local_assigns[:labelled] %>
  <button type="button" title="Snooze" class="<%= labelled ? task_panel_button_classes : task_button_classes %>" data-he-click="open = !open">
    <%= task_action_content "fa-clock", "Snooze", labelled: labelled %>
  </button>

  <%# Backdrop %>
  <div class="fixed inset-0 bg-black/50 z-40" hidden data-he-hidden="!open" data-he-click="open = false"></div>

  <%# Modal %>
  <div class="<%= modal_classes %>" hidden data-he-hidden="!open" data-snooze-modal>

    <%# Header %>
    <div class="flex items-center justify-between px-4 py-3 border-b border-border-secondary">
      <h3 class="text-sm font-semibold text-text-primary m-0">Snooze</h3>
      <button type="button" title="Close" class="text-text-tertiary hover:text-text-primary cursor-pointer" data-he-click="open = false">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <%# Options %>
    <div class="p-2">
      <div class="px-3 py-2 text-xs text-text-tertiary uppercase tracking-wide">Snooze for</div>
      <% [ [ "Day", "fa-sun", 1.day ], [ "3 Days", "fa-calendar-day", 3.days ], [ "Week", "fa-calendar-week", 1.week ],
           [ "Month", "fa-calendar-days", 1.month ], [ "Forever", "fa-infinity", 200.years ] ].each do |label, icon, duration| %>
        <div class="px-3 py-2.5 cursor-pointer rounded-lg hover:bg-surface-hover text-text-secondary text-sm flex items-center gap-2"
             data-he-click="[open = false, $patch('<%= task_path(task) %>', { task: { snoozed_until: '<%= duration.from_now.iso8601 %>' } })]">
          <i class="fa-solid <%= icon %> w-4 text-center text-xs"></i> <%= label %>
        </div>
      <% end %>
    </div>
  </div>
</div>
