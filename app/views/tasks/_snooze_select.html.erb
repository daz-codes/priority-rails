<div data-controller="snoozer" data-snoozer-task-id-value="<%= task.id %>" class="relative inline-block">
  <button title="Snooze" class="<%= task_button_classes %>" data-action="click->snoozer#toggle">
    <i class="fa-solid fa-clock"></i>
  </button>

  <%# Backdrop %>
  <div data-snoozer-target="backdrop" class="fixed inset-0 bg-black/50 z-40" hidden data-action="click->snoozer#close"></div>

  <%# Modal %>
  <div data-snoozer-target="modal" class="<%= modal_classes %>" hidden>

    <%# Header %>
    <div class="flex items-center justify-between px-4 py-3 border-b border-border-secondary">
      <h3 class="text-sm font-semibold text-text-primary m-0">Snooze</h3>
      <button class="text-text-tertiary hover:text-text-primary cursor-pointer" data-action="click->snoozer#close">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <%# Options %>
    <div class="p-2">
      <div class="px-3 py-2 text-xs text-text-tertiary uppercase tracking-wide">Snooze for</div>
      <% [ [ "Day", "fa-sun", 1.day ], [ "3 Days", "fa-calendar-day", 3.days ], [ "Week", "fa-calendar-week", 1.week ],
           [ "Month", "fa-calendar-days", 1.month ], [ "Forever", "fa-infinity", 200.years ] ].each do |label, icon, duration| %>
        <div class="px-3 py-2.5 cursor-pointer rounded-lg hover:bg-surface-hover text-text-secondary text-sm flex items-center gap-2" data-action="click->snoozer#select" data-snooze-until="<%= duration.from_now.iso8601 %>">
          <i class="fa-solid <%= icon %> w-4 text-center text-xs"></i> <%= label %>
        </div>
      <% end %>
    </div>
  </div>
</div>
