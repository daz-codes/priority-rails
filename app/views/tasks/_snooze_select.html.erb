<%# Opens the page's shared snooze modal (tasks/_modals) for this task %>
<% labelled = local_assigns[:labelled] %>
<button type="button" title="Snooze" class="<%= labelled ? task_panel_button_classes : task_button_classes %>"
        data-he-click="snoozeTask = <%= { url: task_path(task) }.to_json %>">
  <%= task_action_content "fa-clock", "Snooze", labelled: labelled %>
</button>
