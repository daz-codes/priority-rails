<%# The year's tasks load the first time it's opened: the frame is lazy, and closed <details> content isn't visible %>
<details class="group">
  <summary class="list-none cursor-pointer text-xl font-heading text-left pl-4 m-0 text-brand-grey hover:text-text-primary transition-colors select-none">
    <span class="inline-block transition-transform group-open:rotate-90">▸</span> <%= year %>
  </summary>
  <%= turbo_frame_tag "completed_year_#{year}", src: completed_year_list_path(list, year: year), loading: :lazy do %>
    <p class="italic text-sm text-brand-grey my-2 ml-4">Loading…</p>
  <% end %>
</details>
