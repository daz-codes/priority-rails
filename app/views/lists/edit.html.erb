<% content_for :title, "Settings — #{@list.name}" %>

<div class="max-w-lg mx-auto space-y-4 py-4">
  <div class="text-center pb-2">
    <div class="text-[11px] font-black uppercase tracking-wider text-text-tertiary">Settings</div>
    <h1 class="text-3xl font-heading m-0 break-words"><%= @list.name %></h1>
  </div>

  <%# ── List Name ─────────────────────────────── %>
  <section class="<%= panel_classes %>">
    <h2 class="<%= panel_heading_classes %>">List Name</h2>
    <%= form_with(model: @list, class: "flex gap-2") do |form| %>
      <%= form.text_field :name, class: field_classes %>
      <%= form.submit "Save", class: primary_button_classes %>
    <% end %>
  </section>

  <%# ── Members ───────────────────────────────── %>
  <% owner = @list.owned_by?(Current.user) %>
  <section class="<%= panel_classes %>">
    <h2 class="<%= panel_heading_classes %>">Members</h2>
    <ul class="list-none p-0 m-0 space-y-2 mb-4">
      <% @list.users.each do |user| %>
        <li id="<%= dom_id(user, :member) %>" class="flex items-center gap-3 px-3 py-2 rounded-xl bg-surface-primary">
          <span class="size-8 rounded-full bg-brand-blue text-white flex items-center justify-center font-black text-sm shrink-0"><%= (user.name.presence || user.email_address)[0].upcase %></span>
          <span class="text-base font-bold text-text-primary truncate"><%= user.name.presence || user.email_address %></span>
          <span class="ml-auto flex items-center gap-2 shrink-0">
            <% if @list.owned_by?(user) %>
              <span class="<%= badge_classes %> bg-emerald-100 text-emerald-700">Owner</span>
            <% end %>
            <% if user == Current.user %>
              <span class="<%= badge_classes %> bg-brand-blue text-white">You</span>
            <% elsif owner %>
              <%= button_to "Make owner", transfer_list_membership_path(@list, user), method: :patch,
                    data: { turbo_confirm: "Make #{user.name} the owner? You'll no longer be able to delete this list or remove members." },
                    class: row_action_classes %>
              <%= button_to list_membership_path(@list, user), method: :delete, title: "Remove from list",
                    data: { turbo_confirm: "Remove #{user.name} from this list?" },
                    class: "text-text-muted hover:text-red-400 cursor-pointer bg-transparent border-none p-1" do %>
                <i class="fa-solid fa-xmark text-sm"></i>
              <% end %>
            <% end %>
          </span>
        </li>
      <% end %>
      <% @list.pending_invitations.each do |invite| %>
        <li id="<%= dom_id(invite) %>" class="flex items-center gap-3 px-3 py-2 rounded-xl bg-surface-primary">
          <span class="size-8 rounded-full bg-text-muted text-white flex items-center justify-center font-black text-sm shrink-0"><%= invite.email[0].upcase %></span>
          <span class="text-base font-bold text-text-tertiary truncate"><%= invite.email %></span>
          <span class="ml-auto flex items-center gap-2 shrink-0">
            <span class="<%= badge_classes %> bg-amber-100 text-amber-700" title="Last sent <%= time_ago_in_words(invite.updated_at) %> ago">Pending</span>
            <%= button_to "Resend", resend_list_invitation_path(@list, invite), class: row_action_classes %>
            <%= button_to list_invitation_path(@list, invite), method: :delete, title: "Cancel invite",
                  data: { turbo_confirm: "Cancel the invite to #{invite.email}?" },
                  class: "text-text-muted hover:text-red-400 cursor-pointer bg-transparent border-none p-1" do %>
              <i class="fa-solid fa-xmark text-sm"></i>
            <% end %>
          </span>
        </li>
      <% end %>
    </ul>

    <%= form_with url: add_user_list_path(@list), method: :post, class: "flex gap-2" do |form| %>
      <%= form.email_field :email_address, required: true, placeholder: "Invite by email...", class: field_classes %>
      <%= form.submit "Invite", class: primary_button_classes %>
    <% end %>
  </section>

  <%# ── Categories ────────────────────────────── %>
  <section class="<%= panel_classes %>">
    <h2 class="<%= panel_heading_classes %>">Categories</h2>
    <%# Drag a row's handle to reorder; the order is used for the filter pills and category menus %>
    <div class="space-y-2 mb-3" data-he-import="behaviors/sortable" data-sort-url="<%= sort_list_categories_path(@list) %>"
         data-sort-param="category_ids" data-sort-handle=".category-handle" data-category-list>
      <% @list.categories.each do |category| %>
        <%= render "categories/category", list: @list, category: category %>
      <% end %>
    </div>

    <% if @list.categories.any? %>
      <p class="text-xs font-semibold text-text-tertiary mb-3">The first category is the default for new tasks. Drag <i class="fa-solid fa-grip-vertical"></i> to reorder.</p>
    <% end %>
    <%= form_with url: list_categories_path(@list), method: :post, class: "flex gap-2" do |form| %>
      <%= form.text_field :name, required: true, placeholder: "New category...", class: field_classes %>
      <%= form.submit "Add", class: primary_button_classes %>
    <% end %>
  </section>

  <%# ── Focus ────────────────────────────────── %>
  <section class="<%= panel_classes %>">
    <h2 class="<%= panel_heading_classes %>">Focus</h2>
    <%= form_with(model: @list, class: "flex items-center gap-3") do |form| %>
      <%= form.number_field :focus_limit, min: 1, max: 20, data: { he_change: "$el.form.requestSubmit()" }, class: "#{field_classes} !w-24 text-center" %>
      <span class="text-base font-bold text-text-secondary">tasks in focus view</span>
    <% end %>
  </section>

  <%# ── Completed Tasks ─────────────────────── %>
  <section class="<%= panel_classes %>">
    <h2 class="<%= panel_heading_classes %>">Completed Tasks</h2>
    <%= form_with(model: @list, class: "flex flex-wrap items-center gap-3") do |form| %>
      <span class="text-base font-bold text-text-secondary">Show completed tasks in inbox for</span>
      <%= form.select :completed_display, List::COMPLETED_DISPLAY_OPTIONS, {}, data: { he_change: "$el.form.requestSubmit()" }, class: "#{field_classes} !w-auto" %>
    <% end %>
  </section>

  <%# ── Copy or archive ─────────────────────── %>
  <section class="<%= panel_classes %>">
    <h2 class="<%= panel_heading_classes %>">Copy or Archive</h2>
    <p class="text-sm font-medium text-text-tertiary mt-0 mb-3">
      Duplicate this list to reuse it, like a packing list or weekly routine. The copy is yours alone and has the
      same categories and tasks, all starting again as not done.
    </p>
    <%= form_with url: duplicate_list_path(@list), method: :post, class: "flex gap-2 mb-4" do |form| %>
      <%= form.text_field :name, value: "#{@list.name} (copy)", "aria-label": "Name for the copy", class: field_classes %>
      <%= form.submit "Duplicate", class: primary_button_classes %>
    <% end %>

    <% if owner %>
      <div class="flex flex-wrap items-center gap-3">
        <% if @list.archived? %>
          <%= button_to "Unarchive list", unarchive_list_path(@list), class: secondary_button_classes %>
        <% else %>
          <%= button_to archive_list_path(@list), class: secondary_button_classes,
                data: { turbo_confirm: "Archive this list? It'll be hidden from everyone's menu but nothing is deleted. You can unarchive it from Archived Lists in the menu." } do %>
            <i class="fa-solid fa-box-archive"></i> Archive list
          <% end %>
        <% end %>
        <span class="text-xs font-semibold text-text-tertiary">Hides it from the menu without deleting anything.</span>
      </div>
    <% end %>
  </section>

  <div class="flex items-center justify-center gap-4 pt-2">
    <%= link_to @list, class: secondary_button_classes, data: { escape_back: true } do %>
      <i class="fa-solid fa-arrow-left"></i> Back to list
    <% end %>
    <% if owner %>
      <%= button_to list_path(@list), method: :delete, class: "#{secondary_button_classes} !text-red-500 hover:!border-red-400", data: { turbo_confirm: "Are you sure you want to delete this list and all its tasks?" } do %>
        <i class="fa-solid fa-trash-can"></i> Delete list
      <% end %>
    <% else %>
      <%= button_to list_membership_path(@list, Current.user), method: :delete, class: "#{secondary_button_classes} !text-red-500 hover:!border-red-400", data: { turbo_confirm: "Leave this list? You'll need a new invite to rejoin." } do %>
        <i class="fa-solid fa-right-from-bracket"></i> Leave list
      <% end %>
    <% end %>
  </div>

</div>
