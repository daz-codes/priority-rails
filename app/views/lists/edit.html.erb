<% content_for :title, "Settings — #{@list.name}" %>

<div class="max-w-lg mx-auto space-y-8 py-4">

  <%# ── List Name ─────────────────────────────── %>
  <section>
    <h2 class="text-lg font-heading font-bold mb-3 border-b border-border-primary pb-2">List Name</h2>
    <%= form_with(model: @list, class: "flex gap-2") do |form| %>
      <%= form.text_field :name, class: "flex-1 min-w-0 px-3 py-2 border border-border-input rounded-lg text-base focus:outline-none focus:border-sky-400 bg-input-bg" %>
      <%= form.submit "Save", class: "px-4 py-2 rounded-full bg-sky-400 text-white font-semibold cursor-pointer hover:bg-sky-500 transition-all duration-100 text-sm" %>
    <% end %>
  </section>

  <%# ── Members ───────────────────────────────── %>
  <% owner = @list.owned_by?(Current.user) %>
  <section>
    <h2 class="text-lg font-heading font-bold mb-3 border-b border-border-primary pb-2">Members</h2>
    <ul class="list-none p-0 m-0 space-y-2 mb-4">
      <% @list.users.each do |user| %>
        <li id="<%= dom_id(user, :member) %>" class="flex items-center gap-3 px-3 py-2 rounded-lg bg-surface-secondary">
          <span class="size-8 rounded-full bg-sky-400 text-white flex items-center justify-center font-bold text-sm shrink-0"><%= (user.name.presence || user.email_address)[0].upcase %></span>
          <span class="text-sm text-text-secondary truncate"><%= user.name.presence || user.email_address %></span>
          <span class="ml-auto flex items-center gap-2 shrink-0">
            <% if @list.owned_by?(user) %>
              <span class="text-[10px] px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-700 font-semibold">Owner</span>
            <% end %>
            <% if user == Current.user %>
              <span class="text-[10px] px-2 py-0.5 rounded-full bg-sky-100 text-sky-600 font-semibold">You</span>
            <% elsif owner %>
              <%= button_to "Make owner", transfer_list_membership_path(@list, user), method: :patch,
                    data: { turbo_confirm: "Make #{user.name} the owner? You'll no longer be able to delete this list or remove members." },
                    class: "text-xs text-text-tertiary hover:text-text-primary cursor-pointer bg-transparent border-none p-1" %>
              <%= button_to list_membership_path(@list, user), method: :delete, title: "Remove from list",
                    data: { turbo_confirm: "Remove #{user.name} from this list?" },
                    class: "text-text-muted hover:text-red-400 cursor-pointer bg-transparent border-none p-1" do %>
                <i class="fa-solid fa-xmark text-xs"></i>
              <% end %>
            <% end %>
          </span>
        </li>
      <% end %>
      <% @list.pending_invitations.each do |invite| %>
        <li id="<%= dom_id(invite) %>" class="flex items-center gap-3 px-3 py-2 rounded-lg bg-surface-secondary">
          <span class="size-8 rounded-full bg-text-muted text-white flex items-center justify-center font-bold text-sm shrink-0"><%= invite.email[0].upcase %></span>
          <span class="text-sm text-text-tertiary truncate"><%= invite.email %></span>
          <span class="ml-auto flex items-center gap-2 shrink-0">
            <span class="text-[10px] px-2 py-0.5 rounded-full bg-yellow-100 text-yellow-600 font-semibold" title="Last sent <%= time_ago_in_words(invite.updated_at) %> ago">Pending</span>
            <%= button_to "Resend", resend_list_invitation_path(@list, invite),
                  class: "text-xs text-text-tertiary hover:text-text-primary cursor-pointer bg-transparent border-none p-1" %>
            <%= button_to list_invitation_path(@list, invite), method: :delete, title: "Cancel invite",
                  data: { turbo_confirm: "Cancel the invite to #{invite.email}?" },
                  class: "text-text-muted hover:text-red-400 cursor-pointer bg-transparent border-none p-1" do %>
              <i class="fa-solid fa-xmark text-xs"></i>
            <% end %>
          </span>
        </li>
      <% end %>
    </ul>

    <%= form_with url: add_user_list_path(@list), method: :post, class: "flex gap-2" do |form| %>
      <%= form.email_field :email_address, required: true, placeholder: "Invite by email...", class: "flex-1 min-w-0 px-3 py-2 border border-border-input rounded-lg text-sm focus:outline-none focus:border-sky-400 bg-input-bg" %>
      <%= form.submit "Invite", class: "px-4 py-2 rounded-full bg-sky-400 text-white font-semibold cursor-pointer hover:bg-sky-500 transition-all duration-100 text-sm" %>
    <% end %>
  </section>

  <%# ── Categories ────────────────────────────── %>
  <section>
    <h2 class="text-lg font-heading font-bold mb-3 border-b border-border-primary pb-2">Categories</h2>
    <%# Drag a row's handle to reorder; the order is used for the filter pills and category menus %>
    <div class="space-y-2 mb-4" data-he-import="behaviors/sortable" data-sort-url="<%= sort_list_categories_path(@list) %>"
         data-sort-param="category_ids" data-sort-handle=".category-handle" data-category-list>
      <% @list.categories.each do |category| %>
        <%= render "categories/category", list: @list, category: category %>
      <% end %>
    </div>

    <% if @list.categories.any? %>
      <p class="text-xs text-text-tertiary mb-3"><i class="fa-solid fa-star text-amber-400"></i> marks the default for new tasks. Tap another star to change it.</p>
    <% end %>
    <%= form_with url: list_categories_path(@list), method: :post, class: "flex gap-2" do |form| %>
      <%= form.text_field :name, required: true, placeholder: "New category...", class: "flex-1 min-w-0 px-3 py-2 border border-border-input rounded-lg text-sm focus:outline-none focus:border-sky-400 bg-input-bg" %>
      <%= form.submit "Add", class: "px-4 py-2 rounded-full bg-sky-400 text-white font-semibold cursor-pointer hover:bg-sky-500 transition-all duration-100 text-sm" %>
    <% end %>
  </section>

  <%# ── Focus ────────────────────────────────── %>
  <section>
    <h2 class="text-lg font-heading font-bold mb-3 border-b border-border-primary pb-2">Focus</h2>
    <%= form_with(model: @list, class: "flex items-center gap-2") do |form| %>
      <%= form.number_field :focus_limit, min: 1, max: 20, data: { he_change: "$el.form.requestSubmit()" }, class: "w-20 px-3 py-2 border border-border-input rounded-lg text-base text-center focus:outline-none focus:border-sky-400 bg-input-bg" %>
      <span class="text-sm text-text-secondary">tasks in focus view</span>
    <% end %>
  </section>

  <%# ── Completed Tasks ─────────────────────── %>
  <section>
    <h2 class="text-lg font-heading font-bold mb-3 border-b border-border-primary pb-2">Completed Tasks</h2>
    <%= form_with(model: @list, class: "flex items-center gap-2") do |form| %>
      <span class="text-sm text-text-secondary">Show completed tasks in inbox for</span>
      <%= form.select :completed_display, List::COMPLETED_DISPLAY_OPTIONS, {}, data: { he_change: "$el.form.requestSubmit()" }, class: "px-3 py-2 border border-border-input rounded-lg text-sm focus:outline-none focus:border-sky-400 bg-input-bg" %>
    <% end %>
  </section>

  <%# ── Copy or archive ─────────────────────── %>
  <section>
    <h2 class="text-lg font-heading font-bold mb-3 border-b border-border-primary pb-2">Copy or Archive</h2>
    <p class="text-xs text-text-tertiary mb-2">
      Duplicate this list to reuse it, like a packing list or weekly routine. The copy is yours alone and has the
      same categories and tasks, all starting again as not done.
    </p>
    <%= form_with url: duplicate_list_path(@list), method: :post, class: "flex gap-2 mb-4" do |form| %>
      <%= form.text_field :name, value: "#{@list.name} (copy)", "aria-label": "Name for the copy",
            class: "flex-1 min-w-0 px-3 py-2 border border-border-input rounded-lg text-sm focus:outline-none focus:border-sky-400 bg-input-bg" %>
      <%= form.submit "Duplicate", class: "px-4 py-2 rounded-full bg-sky-400 text-white font-semibold cursor-pointer hover:bg-sky-500 transition-all duration-100 text-sm" %>
    <% end %>

    <% if owner %>
      <div class="flex items-center gap-3">
        <% if @list.archived? %>
          <%= button_to "Unarchive list", unarchive_list_path(@list), class: "px-4 py-2 rounded-full border border-border-input text-sm font-semibold text-text-secondary hover:bg-surface-hover cursor-pointer bg-surface-primary" %>
        <% else %>
          <%= button_to archive_list_path(@list), class: "px-4 py-2 rounded-full border border-border-input text-sm font-semibold text-text-secondary hover:bg-surface-hover cursor-pointer bg-surface-primary",
                data: { turbo_confirm: "Archive this list? It'll be hidden from everyone's menu but nothing is deleted. You can unarchive it from Archived Lists in the menu." } do %>
            <i class="fa-solid fa-box-archive text-xs"></i> Archive list
          <% end %>
        <% end %>
        <span class="text-xs text-text-tertiary">Hides it from the menu without deleting anything.</span>
      </div>
    <% end %>
  </section>

  <div class="flex items-center justify-center gap-4">
    <%= link_to "Back to list", @list, class: "text-sm text-text-tertiary hover:text-text-secondary no-underline", data: { escape_back: true } %>
    <span class="text-text-muted">|</span>
    <% if owner %>
      <%= button_to list_path(@list), method: :delete, class: "inline", data: { turbo_confirm: "Are you sure you want to delete this list and all its tasks?" } do %>
        <span class="text-sm text-red-400 hover:text-red-600 cursor-pointer">Delete list</span>
      <% end %>
    <% else %>
      <%= button_to list_membership_path(@list, Current.user), method: :delete, class: "inline", data: { turbo_confirm: "Leave this list? You'll need a new invite to rejoin." } do %>
        <span class="text-sm text-red-400 hover:text-red-600 cursor-pointer">Leave list</span>
      <% end %>
    <% end %>
  </div>

</div>
