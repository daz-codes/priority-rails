<% content_for :title, "Archived Lists" %>

<div class="max-w-lg mx-auto flex flex-col gap-4 py-4">
  <h1 class="text-3xl font-heading text-center m-0">Archived Lists</h1>

  <% if @lists.any? %>
    <ul class="list-none p-0 m-0 space-y-2">
      <% @lists.each do |list| %>
        <li id="<%= dom_id(list, :archived) %>" class="flex flex-wrap items-center gap-3 px-4 py-3 rounded-(--card-radius) bg-surface-secondary">
          <div class="min-w-0 flex-1">
            <%= link_to list.name, list, class: "block truncate text-lg font-extrabold tracking-tight text-text-primary no-underline hover:underline" %>
            <span class="text-xs font-semibold text-text-tertiary">
              Archived <%= time_ago_in_words(list.archived_at) %> ago · <%= pluralize(list.tasks.size, "task") %>
            </span>
          </div>
          <%= button_to "Duplicate", duplicate_list_path(list), params: { name: list.name },
                class: secondary_button_classes %>
          <% if list.owned_by?(Current.user) %>
            <%= button_to "Unarchive", unarchive_list_path(list),
                  class: primary_button_classes %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text-center text-base font-bold text-text-tertiary">No archived lists.</p>
  <% end %>

  <div class="text-center">
    <%= link_to root_path, class: secondary_button_classes do %>
      <i class="fa-solid fa-arrow-left"></i> Back
    <% end %>
  </div>
</div>
