<% content_for :title, @list.name %>
<%= turbo_refreshes_with method: :morph, scroll: :preserve %>
<%= turbo_stream_from @list %>

<%# Focus mode shows only the tasks; the layout hides the menu button too %>
<% content_for :focus_mode, "true" if @priority %>

<section class="min-w-0 overflow-x-clip <%= 'pt-6' if @priority %>">
<% if @list.archived? %>
  <div class="flex items-center justify-center gap-3 mb-4 px-4 py-2.5 rounded-(--card-radius) bg-amber-50 text-amber-800 dark:bg-amber-950 dark:text-amber-200 text-sm" data-archived-banner>
    <i class="fa-solid fa-box-archive"></i>
    <span>This list is archived.</span>
    <% if @list.owned_by?(Current.user) %>
      <%= button_to "Unarchive", unarchive_list_path(@list), class: "px-3 py-1 rounded-(--card-radius) bg-amber-500 text-white font-semibold cursor-pointer hover:bg-amber-600 border-0" %>
    <% end %>
  </div>
<% end %>

<% unless @priority %>
  <%= render "tabs" %>
  <%= render "title" %>
  <%= render "progress", done: @done_today, total: @done_today + @still_to_do %>
  <%= render "category_filters" unless @list.categories.none? %>
  <%= render "task_form" %>
<% end %>

<% if @filter == "completed" %>
<div id="tasks">
    <%= render "completed_list", title: "Today", tasks: @tasks.completed_today %>
    <%= render "completed_list", title: "Yesterday", tasks: @tasks.completed_yesterday %>
    <%= render "completed_list", title: "This Week", tasks: @tasks.completed_this_week %>
    <%= render "completed_list", title: "This Month", tasks: @tasks.completed_this_month %>
    <% @completed_years.each do |year| %>
      <%= render "completed_year_placeholder", list: @list, year: year %>
    <% end %>
</div>
<% elsif @tasks.any? %>
    <%= tag.ul id: "tasks",
        class: class_names("p-1 list-none", "focus-list": @priority),
        data: (@filter ? {} : { he_import: "behaviors/sortable", sort_url: sort_tasks_path }) do %>
        <%= render partial: "tasks/task", collection: @tasks, as: :task, locals: { highlight: flash[:highlight] } %>
    <% end %>
<% else %>
  <p id="tasks" class="text-center text-brand-grey px-4">No tasks yet!</p>
<% end %>

<%= render "tasks/modals" %>

<% if @priority %>
  <%= link_to "Back to inbox", list_path(@list), data: { escape_back: true },
        class: "block w-fit mx-auto mt-8 text-sm text-text-tertiary hover:text-text-secondary no-underline" %>
<% end %>
</section>
