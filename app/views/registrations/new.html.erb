<div class="max-w-md mx-auto py-8">
  <div class="text-center mb-8">
    <%= logo :large %>
    <p class="text-lg font-bold text-text-secondary mt-2 mb-6">Create your account</p>
  </div>

  <div class="bg-surface-secondary rounded-2xl p-6 mb-6">
    <%= form_with model: @user, url: registration_path, class: "space-y-3" do |f| %>
      <% if @user.errors.any? %>
        <div class="<%= error_box_classes %>"><%= @user.errors.full_messages.to_sentence %></div>
      <% end %>

      <%= f.email_field :email_address, placeholder: "Email address", class: field_classes %>
      <%= f.password_field :password, placeholder: "Choose a password (8+ characters)", minlength: 8, maxlength: 72, class: field_classes %>
      <%= f.submit "Create Account", class: "#{primary_button_classes} w-full !py-3" %>
    <% end %>
  </div>

  <div class="text-center text-sm font-semibold text-text-tertiary">
    <p class="m-0">Already have an account? <%= link_to "Sign in", login_path, class: "text-brand-blue font-black uppercase tracking-wider text-xs no-underline hover:brightness-110" %></p>
  </div>
</div>
